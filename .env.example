# Discord application (Developer Portal). TOKEN change still needs a process restart.
TOKEN=
CLIENT_ID=
# Optional: register slash commands to one guild instantly while developing.
GUILD_ID=
# Comma-separated snowflakes. These users can run /log everywhere.
OWNER_IDS=

# SQLite file. Created automatically.
DATABASE_PATH=./data/logyazicam.sqlite

# Fallback locale if a guild has none:
# en tr de fr es pt it nl pl ru uk ar ja ko zh sv hi id
DEFAULT_LOCALE=en
# IANA timezone used when a guild has none.
DEFAULT_TIMEZONE=UTC

# Process log level: error | warn | info | debug
LOG_LEVEL=info
LOG_FILE=./data/process.log

# Where the bot reports its own failures (optional). Guild channel snowflake.
ERROR_CHANNEL_ID=
# Also DM the first OWNER_IDS entry on fatal errors (true/false).
ERROR_DM_OWNER=false

# Re-read .env (except TOKEN) and flush guild cache on this interval. 0 disables.
HOT_RELOAD_MS=15000

# Dispatch
MAX_QUEUE_PER_CHANNEL=20
SEND_INTERVAL_MS=350
AUDIT_MAX_AGE_MS=12000
WEBHOOK_NAME=LogYazicam
WEBHOOK_AVATAR_URL=

# Embed defaults (guild config overrides these)
EMBED_SHOW_IDS=true
EMBED_SHOW_JUMP=true
EMBED_COMPACT=false
EMBED_FOOTER=LogYazicam
IGNORE_BOTS=true
IGNORE_WEBHOOKS=true
IGNORE_SELF=true
STORE_HISTORY=true
HISTORY_LIMIT=200

# Defaults for NEW guilds / until /log set overrides them (hot-reloaded except TOKEN)
DEFAULT_PAUSED=false
DEFAULT_PLAIN_TEXT=false
DEFAULT_SHOW_THUMBNAILS=true
DEFAULT_SHOW_TIMESTAMP=true
DEFAULT_ATTACH_LONG=true
DEFAULT_QUIET_START=
DEFAULT_QUIET_END=
DEFAULT_MIN_ACCOUNT_DAYS=0
DEFAULT_COOLDOWN_SEC=0
# all | humans | bots
DEFAULT_ACTORS=all
WEBHOOK_USERNAME=LogYazicam

# Presence shown in the member list (applied on ready; type: Playing Watching Listening Competing Custom)
ACTIVITY_TYPE=Watching
ACTIVITY_TEXT=guild logs · /log
# online | idle | dnd | invisible
ACTIVITY_STATUS=online

# Control surface
PREFIX_ENABLED=true
PREFIX=!
SLASH_ENABLED=true
# embed | plain | webhook  (webhook still needs /log webhook id+token)
DEFAULT_DELIVERY=embed
ALLOW_WEBHOOK_FALLBACK=true
MENTION_USERS=false

# Command surface
COMMAND_NAME=log
# Discord permission name required to configure (owners bypass)
CONFIG_PERMISSION=ManageGuild
SLASH_EPHEMERAL=true
SHOW_CREDIT=true

# Truncation / audit
EMBED_FIELD_MAX=1024
EMBED_DESC_MAX=4000
EMBED_FOOTER_MAX=2048
PLAIN_MAX=1900
ERROR_MESSAGE_MAX=1900
ATTACH_MIN_CHARS=1800
AUDIT_FETCH_LIMIT=6
BULK_LINE_LIMIT=40
HISTORY_EXPORT_DEFAULT=50

# Default embed colors (decimal). Guild /log color overrides.
COLOR_CREATE=5763719
COLOR_UPDATE=16705372
COLOR_DELETE=15548997
COLOR_VOICE=5793266
COLOR_MEMBER=15418782
COLOR_MOD=15888674
COLOR_INFO=5793266
