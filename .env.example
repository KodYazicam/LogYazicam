# Discord application (Developer Portal). TOKEN change still needs a process restart.
TOKEN=
CLIENT_ID=
# Optional: register slash commands to one guild instantly while developing.
GUILD_ID=
# Comma-separated snowflakes. These users can run /log everywhere.
OWNER_IDS=

# SQLite file. Created automatically.
DATABASE_PATH=./data/logyazicam.sqlite

# Fallback locale if a guild has none:
# en tr de fr es pt it nl pl ru uk ar ja ko zh
DEFAULT_LOCALE=en
# IANA timezone used when a guild has none.
DEFAULT_TIMEZONE=UTC

# Process log level: error | warn | info | debug
LOG_LEVEL=info
LOG_FILE=./data/process.log

# Where the bot reports its own failures (optional). Guild channel snowflake.
ERROR_CHANNEL_ID=
# Also DM the first OWNER_IDS entry on fatal errors (true/false).
ERROR_DM_OWNER=false

# Re-read .env (except TOKEN) and flush guild cache on this interval. 0 disables.
HOT_RELOAD_MS=15000

# Dispatch
MAX_QUEUE_PER_CHANNEL=20
SEND_INTERVAL_MS=350
AUDIT_MAX_AGE_MS=12000
WEBHOOK_NAME=LogYazicam
WEBHOOK_AVATAR_URL=

# Embed defaults (guild config overrides these)
EMBED_SHOW_IDS=true
EMBED_SHOW_JUMP=true
EMBED_COMPACT=false
EMBED_FOOTER=LogYazicam
IGNORE_BOTS=true
IGNORE_WEBHOOKS=true
IGNORE_SELF=true
STORE_HISTORY=true
HISTORY_LIMIT=200
