  "bugs": {
    "url": "https://github.com/KodYazicam/LogYazicam/issues"
  },
  "homepage": "https://github.com/KodYazicam/LogYazicam#readme",
  "dependencies": {
    "better-sqlite3": "^9.2.2",
    "discord.js": "^14.16.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
