{
  "name": "logyazicam",
  "version": "1.1.0",
  "description": "Per-guild Discord logging bot. Every gateway event that Discord actually emits, routed and formatted from SQLite + env. No restart for config.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "deploy": "node src/deploy-commands.js",
    "dev": "nodemon src/index.js",
    "check": "node scripts/check-syntax.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KodYazicam/LogYazicam.git"
  },
  "author": "KodYazicam <https://github.com/KodYazicam>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/KodYazicam/LogYazicam/issues"
  },
  "homepage": "https://github.com/KodYazicam/LogYazicam#readme",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.9"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
